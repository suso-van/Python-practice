      "source": [
        "def count_vowels(text):\n",
        "    \"\"\"\n",
        "    Counts the number of vowels (a, e, i, o, u) in a given string or list of words.\n",
        "    Returns the total count and a dictionary containing the count of each vowel.\n",
        "    \"\"\"\n",
        "    vowels = \"aeiouAEIOU\"\n",
        "    vowel_counts = {v: 0 for v in \"aeiou\"}\n",
        "    total_count = 0\n",
        "\n",
        "    for char in text:\n",
        "        if char in vowels:\n",
        "            vowel_counts[char.lower()] += 1\n",
        "            total_count += 1\n",
        "\n",
        "    return total_count, vowel_counts\n",
        "\n",
        "# Sample text\n",
        "sample_words = \"Google Colab Notebook\"\n",
        "total, individual_counts = count_vowels(sample_words)\n",
        "\n",
        "print(f\"Text: \\\"{sample_words}\\\"\")\n",
        "print(f\"Total Vowels: {total}\")\n",
        "print(\"Vowel breakdown:\")\n",
        "for vowel, count in individual_counts.items():\n",
        "    print(f\"  {vowel}: {count}\")"
      ],
