        "def filter_student_marks(marks_dict, threshold):\n",
        "    \"\"\"\n",
        "    Filters a dictionary of students and their marks, returning only those\n",
        "    who scored greater than or equal to the specified threshold.\n",
        "    \"\"\"\n",
        "    return {student: mark for student, mark in marks_dict.items() if mark >= threshold}\n",
        "\n",
        "# Sample Student Data\n",
        "student_marks = {\n",
        "    \"Alice\": 85,\n",
        "    \"Bob\": 58,\n",
        "    \"Charlie\": 92,\n",
        "    \"David\": 45,\n",
        "    \"Eva\": 73\n",
        "}\n",
        "\n",
        "# Filter students with marks greater than or equal to 60\n",
        "passing_students = filter_student_marks(student_marks, 60)\n",
        "print(\"Students who passed (scored >= 60):\")\n",
        "for student, mark in passing_students.items():\n",
        "    print(f\"{student}: {mark}\")"
