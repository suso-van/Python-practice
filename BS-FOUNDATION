        "def print_pattern_v(height=5):\n",
        "    print(\"--- Pattern V ---\")\n",
        "    for i in range(height):\n",
        "        for j in range(2 * height):\n",
        "            if j == i or j == (2 * height - 2 - i):\n",
        "                print(\"*\", end=\"\")\n",
        "            else:\n",
        "                print(\" \", end=\"\")\n",
        "        print()\n",
        "\n",
        "def print_pattern_x(height=5):\n",
        "    print(\"\\n--- Pattern X ---\")\n",
        "    if height % 2 == 0:\n",
        "        height += 1\n",
        "    for i in range(height):\n",
        "        for j in range(height):\n",
        "            if j == i or j == (height - 1 - i):\n",
        "                print(\"*\", end=\"\")\n",
        "            else:\n",
        "                print(\" \", end=\"\")\n",
        "        print()\n",
        "\n",
        "def print_pattern_n(height=6):\n",
        "    print(\"\\n--- Pattern N ---\")\n",
        "    for i in range(height):\n",
        "        for j in range(height):\n",
        "            if j == 0 or j == height - 1 or i == j:\n",
        "                print(\"*\", end=\"\")\n",
        "            else:\n",
        "                print(\" \", end=\"\")\n",
        "        print()\n",
        "\n",
        "def print_pattern_w(height=5):\n",
        "    print(\"\\n--- Pattern W ---\")\n",
        "    for i in range(height):\n",
        "        for j in range(4 * height):\n",
        "            # Outer left diagonal, inner diagonals (making the peak in the middle), outer right diagonal\n",
        "            if j == i or j == (2 * height - 2 - i) or j == (2 * height + i) or j == (4 * height - 2 - i):\n",
        "                print(\"*\", end=\"\")\n",
        "            else:\n",
        "                print(\" \", end=\"\")\n",
        "        print()\n",
        "\n",
        "def print_pattern_z(height=5):\n",
        "    print(\"\\n--- Pattern Z ---\")\n",
        "    for i in range(height):\n",
        "        for j in range(height):\n",
        "            if i == 0 or i == height - 1 or j == (height - 1 - i):\n",
        "                print(\"*\", end=\"\")\n",
        "            else:\n",
        "                print(\" \", end=\"\")\n",
        "        print()\n",
        "\n",
        "# Run demonstrations\n",
        "print_pattern_v()\n",
        "print_pattern_x()\n",
        "print_pattern_n()\n",
        "print_pattern_w()\n",
        "print_pattern_z()"
      ],
