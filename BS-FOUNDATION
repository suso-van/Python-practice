      "source": [
        "def print_triangle(height=5):\n",
        "    print(\"--- Triangle Pattern ---\")\n",
        "    for i in range(height):\n",
        "        # Print leading spaces\n",
        "        print(\" \" * (height - i - 1), end=\"\")\n",
        "        # Print stars\n",
        "        print(\"*\" * (2 * i + 1))\n",
        "    print()\n",
        "\n",
        "def print_diamond(height=5):\n",
        "    print(\"--- Diamond Pattern ---\")\n",
        "    # Upper half\n",
        "    for i in range(height):\n",
        "        print(\" \" * (height - i - 1), end=\"\")\n",
        "        print(\"*\" * (2 * i + 1))\n",
        "    # Lower half\n",
        "    for i in range(height - 2, -1, -1):\n",
        "        print(\" \" * (height - i - 1), end=\"\")\n",
        "        print(\"*\" * (2 * i + 1))\n",
        "    print()\n",
        "\n",
        "def print_hexagon(side=4):\n",
        "    print(\"--- Hexagon Pattern ---\")\n",
        "    # Top half (including middle)\n",
        "    for i in range(side):\n",
        "        print(\" \" * (side - i - 1), end=\"\")\n",
        "        print(\"*\" * (side + 2 * i))\n",
        "    # Bottom half\n",
        "    for i in range(side - 2, -1, -1):\n",
        "        print(\" \" * (side - i - 1), end=\"\")\n",
        "        print(\"*\" * (side + 2 * i))\n",
        "    print()\n",
        "\n",
        "# Run demonstrations\n",
        "print_triangle(5)\n",
        "print_diamond(5)\n",
        "print_hexagon(4)"
